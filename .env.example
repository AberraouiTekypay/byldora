# BYLDORA — Enterprise Procurement Intelligence
# Application Environment Variables Template

# Application
NEXT_PUBLIC_APP_URL=https://byldora.vercel.app
NEXT_PUBLIC_APP_ENV=production

# Database & Cache (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@host:5432/byldora_db?sslmode=require

# Authentication & Session Security (NextAuth / JWT Secret)
AUTH_SECRET=generate_strong_random_secret_min_32_chars
NEXTAUTH_URL=https://byldora.vercel.app

# Object Storage (AWS S3 / Cloudflare R2 / MinIO for BOQ spreadsheets & scanned quotes)
STORAGE_URL=https://s3.eu-west-1.amazonaws.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=byldora-tender-documents

# Document Parsing & AI Normalization Engine
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
